# Only CITY_CODE has to change per city. Everything below the required
# section already has a working default baked into the scripts - only
# uncomment/edit if your setup actually differs.

# Bounding box is no longer set here - it's looked up automatically from
# raw_map_files/{CITY_CODE}/{CITY_CODE}_MAP_DATA.json. The first time you
# run a script for a city with no saved bbox yet, it'll prompt you to paste one
# in (e.g. copied from boundingbox.klokantech.com) and save it for next time.
CITY_CODE = "FRA"

# Only needed for publish.py / release_maptools.py.
GITHUB_TOKEN = "<Github_Token_Classic>"

# --- Optional overrides (defaults shown) ---
# OSMPBF = "germany-latest.osm.pbf"
# CSV = "QZM_1X1KM.csv"
# RAW_BASE_DIR = "raw_map_files"
# OUTPUT_DIR = "Map_ZIPs"
# OSRM_URL = "http://localhost:5000"

# Hub (demand point) size dials - independent for residential (commuter-
# origin) hubs vs. job hubs. 1 = original tuning for that side. Set to 4 for
# hubs roughly 4x smaller and ~4x more numerous on that side; 0.5 for ~2x
# bigger/fewer. Real-world commuter totals never change, only how finely
# they're split across points and how many separate points they land on.
#
# Useful when jobs are spread across too many small, separate destinations
# to design a profitable line around - lower JOB_SIZE_RATIO (e.g. 0.5)
# consolidates jobs into fewer, bigger hubs without touching residential
# granularity at all. See the comment above RES_SIZE_RATIO/JOB_SIZE_RATIO in
# generate_demand_qzm_local.py.
# RES_SIZE_RATIO = "1"
# JOB_SIZE_RATIO = "1"

# --- Required for generate_config.py ---
# Builds config.json for CITY_CODE. "population" is NOT set here - it's
# always computed by summing demand_data.json's pops[].size, since depot's
# create_description() asserts config["population"] must match that sum
# exactly. initialViewState is also never set here - it's always
# zoom=15/bearing=0 with latitude/longitude at the center of the saved bbox.
MAP_NAME = "Berlin"
MAP_CODE = "BER2"
# {POPULATION_ROUNDED} is replaced with the real population, rounded to the
# nearest 50,000, formatted with dots (e.g. 1.750.000).
MAP_DESCRIPTION = "Bring the subway to Berlin! Over {POPULATION_ROUNDED} commuters want to go to their workplace and it's your job to get them there!"
MAP_CREATOR = "MergedEyes"
